APP_NAME="NexCart Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL for Production / Docker, SQLite supported for quick local dev)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexcart
DB_USERNAME=nexcart
DB_PASSWORD=secret_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=nexcart_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@nexcart.in"
MAIL_FROM_NAME="NexCart Marketplace"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_nexcart_2026_demo
RAZORPAY_KEY_SECRET=secret_test_key_nexcart_9981
RAZORPAY_WEBHOOK_SECRET=whsec_test_nexcart_sig_5541

# Marketplace Configuration
DEFAULT_COMMISSION_RATE=10.00
CURRENCY_CODE=INR
CURRENCY_SYMBOL="₹"
PAGINATION_LIMIT=15

VITE_APP_NAME="${APP_NAME}"
